# AGCMS environment — copy to .env (gitignored) and fill in real values.

# HMAC-SHA256 key for per-row audit signing (required).
#   python -c "import secrets; print(secrets.token_hex(32))"
AGCMS_SIGNING_KEY=<generate-with-token_hex(32)>

# JWT signing key for dashboard + API auth.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<generate-with-token_urlsafe(48)>

# LLM providers (all have free tiers). At least one is needed. Requests fail
# over along AGCMS_PROVIDER_ORDER when a provider errors or has no key.
GEMINI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434
AGCMS_DEFAULT_PROVIDER=gemini
AGCMS_PROVIDER_ORDER=gemini,groq,openrouter,ollama
AGCMS_FAILOVER=true

# Datastore credentials (local compose only)
POSTGRES_PASSWORD=<set-a-strong-value>
REDIS_PASSWORD=<set-a-strong-value>

# Behaviour knobs
AGCMS_SPACY_MODEL=en_core_web_sm
AGCMS_ML_ENABLED=true
# closed (default): reject requests with 503 if a scan or the policy service is down
AGCMS_FAIL_MODE=closed
AGCMS_TENANT_RPM=            # override; empty = use the tenant policy's rate_limits.requests_per_minute (60 in the default policy)
AGCMS_GLOBAL_IP_RPM=200      # requests per minute per client IP
